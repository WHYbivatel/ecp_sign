{
  "manifest_version": 3,
  "name": "Tegin · локальная ЭЦП",
  "version": "0.5.1",
  "minimum_chrome_version": "111",
  "description": "Локальная электронная подпись ГОСТ/RSA. Подписание CMS/CAdES и XML в браузере.",
  "action": {
    "default_title": "Tegin",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://*.kz/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://tsp.pki.gov.kz/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.kz/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content/inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.kz/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content/bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; worker-src 'self'; style-src 'self'; img-src 'self'; connect-src http://tsp.pki.gov.kz; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
