{
  "name": "tegin",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "description": "Local Kazakhstan digital signatures in a browser extension",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.mjs",
    "test:e2e": "node tests/e2e.mjs && node tests/e2e-revocation.mjs && node tests/e2e-issuance.mjs",
    "test:e2e:firefox": "node tests/e2e-issuance-firefox.mjs && node tests/e2e-revocation-firefox.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:tsp": "node tests/tsp-live.mjs",
    "test:revocation-live": "node tests/revocation-live.mjs"
  },
  "dependencies": {
    "@signpdf/placeholder-pdf-lib": "4.0.0",
    "@signpdf/signpdf": "4.0.0",
    "@signpdf/utils": "4.0.0",
    "@xmldom/xmldom": "^0.9.12",
    "buffer": "6.0.3",
    "node-forge": "^1.4.3",
    "pdf-lib": "1.17.1",
    "xml-crypto": "^6.4.0"
  },
  "devDependencies": {
    "@puppeteer/browsers": "3.2.7",
    "esbuild": "^0.28.2",
    "ncalayer-js-client": "1.6.1",
    "playwright": "^1.64.1",
    "puppeteer-core": "25.17.0"
  }
}
